# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (이메일 발송) - 도메인 인증 후 from 주소 지정
RESEND_API_KEY=re_...
MAIL_FROM="RegTide <digest@yourdomain.com>"

# Vercel Cron 인증 (임의의 긴 랜덤 문자열; Vercel이 Authorization: Bearer 로 전달)
CRON_SECRET=change-me-to-a-long-random-string

# (선택) 건너뛸 소스. 예: iso.org 가 403으로 차단할 때
# DISABLED_SOURCES=page_watch:iso

# 사이트 주소 (수신거부 링크 생성용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
