# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (이메일 발송) - 도메인 인증 후 from 주소 지정
RESEND_API_KEY=re_...
MAIL_FROM="RegTide <digest@yourdomain.com>"

# Vercel Cron 인증 (임의의 긴 랜덤 문자열; Vercel이 Authorization: Bearer 로 전달)
CRON_SECRET=change-me-to-a-long-random-string

# (선택) 건너뛸 소스. 예: iso.org 가 403으로 차단할 때
# DISABLED_SOURCES=page_watch:iso

# 사이트 주소 (구독해지 링크 생성용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (선택) 운영자 리포트 — 매일 08:00 KST 구독자 현황 + 구독자 N명 달성 시 즉시 알림
# ADMIN_EMAIL=ceo@breathings.co.kr
# MILESTONE_EVERY=10

# 관리자 대시보드 (/admin) — 단일 계정. ADMIN_PASSWORD 가 없으면 관리자 페이지 비활성
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# (선택) 세션 쿠키 서명 키. 없으면 CRON_SECRET 사용
# ADMIN_SESSION_SECRET=another-long-random-string

# (선택) 메일 발송 일일 한도 — 상태 점검의 한도 경고 기준. Resend 무료 100, Pro 는 50000 정도로 설정
# RESEND_DAILY_LIMIT=100

# SEO — 검색엔진 소유 확인 (선택). Google Search Console / 네이버 서치어드바이저가 발급하는 meta 값
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
